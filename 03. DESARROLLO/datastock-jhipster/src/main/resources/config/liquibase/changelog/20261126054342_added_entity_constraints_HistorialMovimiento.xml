<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity HistorialMovimiento.
    -->
    <changeSet id="20261126054342-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="producto_id"
                                 baseTableName="historial_movimiento"
                                 constraintName="fk_historial_movimiento__producto_id"
                                 referencedColumnNames="id"
                                 referencedTableName="producto"
                                 />

        <addForeignKeyConstraint baseColumnNames="sitio_id"
                                 baseTableName="historial_movimiento"
                                 constraintName="fk_historial_movimiento__sitio_id"
                                 referencedColumnNames="id"
                                 referencedTableName="sitio"
                                 />

        <addForeignKeyConstraint baseColumnNames="usuario_id"
                                 baseTableName="historial_movimiento"
                                 constraintName="fk_historial_movimiento__usuario_id"
                                 referencedColumnNames="id"
                                 referencedTableName="usuario"
                                 />
    </changeSet>
</databaseChangeLog>
